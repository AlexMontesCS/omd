{
  "name": "@teachinglab/omd",
  "version": "0.9.88",
  "description": "omd",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "unpkg": "./dist/omd.global.js",
  "jsdelivr": "./dist/omd.global.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./browser": {
      "types": "./index.d.ts",
      "default": "./dist/omd.browser.js"
    },
    "./global": "./dist/omd.global.js",
    "./schema": {
      "types": "./schemas.d.ts",
      "import": "./src/omdSchemas.js",
      "default": "./src/omdSchemas.js"
    },
    "./schemas": {
      "types": "./schemas.d.ts",
      "import": "./src/omdSchemas.js",
      "default": "./src/omdSchemas.js"
    },
    "./schema.json": {
      "types": "./schemas.d.ts",
      "default": "./src/schema/omd-schemas.json"
    },
    "./schemas.json": {
      "types": "./schemas.d.ts",
      "default": "./src/schema/omd-schemas.json"
    },
    "./sample": {
      "types": "./samples.d.ts",
      "import": "./src/omdSamples.js",
      "default": "./src/omdSamples.js"
    },
    "./samples": {
      "types": "./samples.d.ts",
      "import": "./src/omdSamples.js",
      "default": "./src/omdSamples.js"
    },
    "./sample.json": {
      "types": "./samples.d.ts",
      "default": "./src/schema/omd-samples.json"
    },
    "./samples.json": {
      "types": "./samples.d.ts",
      "default": "./src/schema/omd-samples.json"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "schemas.d.ts",
    "samples.d.ts",
    "dist/",
    "src/",
    "omd/",
    "docs/",
    "canvas/",
    "jsvg/"  ,
    "npm-docs/",
    "README.md"
  ],
  "keywords": [
    "math",
    "visualization",
    "equations",
    "educational",
    "canvas",
    "svg",
    "interactive"
  ],
  "author": "jaredschiffman",
  "license": "MIT",
  "dependencies": {
    "@teachinglab/jsvg": "^0.1.8",
    "mathjs": "14.5.2",
    "openai": "6.6.0" 
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.browser.config.js && node copy-static.js && node build-docs.js && node build-npm-docs.js",
    "build:browser": "vite build --config vite.browser.config.js",
    "build:docs": "node build-docs.js",
    "build:npm-docs": "node build-npm-docs.js",
    "build:static": "node copy-static.js",
    "dev:netlify": "npm run build:docs && npm run build:npm-docs && netlify dev"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@netlify/vite-plugin": "^2.5.4",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "glob": "^11.0.3",
    "marked": "^16.2.1",
    "openai": "^4.28.0",
    "vite": "^5.4.0"
  }
}
