{
  "omdEquationWork": {
    "type": "object",
    "description": "Worked equation layout with global typography settings.",
    "properties": {
      "omdType": {
        "type": "string",
        "const": "equationWork"
      },
      "fontFamily": {
        "type": "string"
      },
      "fontSize": {
        "type": "number",
        "description": "Global font size applied to all rows."
      },
      "fontWeight": {
        "type": ["string", "number"],
        "description": "Global font weight applied to all rows."
      },
      "rowHeightMultiplier": {
        "type": "number"
      },
      "rowGap": {
        "type": "number"
      },
      "columnGap": {
        "type": "number"
      },
      "paddingX": {
        "type": "number"
      },
      "paddingY": {
        "type": "number"
      },
      "lineGap": {
        "type": "number"
      },
      "lineInset": {
        "type": "number"
      },
      "lineStrokeWidth": {
        "type": "number"
      },
      "centerSymbol": {
        "type": "string"
      },
      "equationColor": {
        "type": "string"
      },
      "operationColor": {
        "type": "string"
      },
      "textColor": {
        "type": "string"
      },
      "centerColor": {
        "type": "string"
      },
      "lineColor": {
        "type": "string"
      },
      "operationLineUp": {
        "type": "string"
      },
      "operationLeftAlign": {
        "type": "string"
      },
      "operationRightAlign": {
        "type": "string"
      },
      "equationLeftAlign": {
        "type": "string"
      },
      "equationRightAlign": {
        "type": "string"
      },
      "drawLineBeforeRows": {
        "type": "array",
        "items": {
          "type": "number"
        }
      },
      "drawLineAfterRows": {
        "type": "array",
        "items": {
          "type": "number"
        }
      },
      "rows": {
        "type": "array",
        "items": {
          "type": ["string", "object"],
          "description": "Row entries no longer support per-row fontSize or fontWeight. Typography is global."
        }
      }
    }
  }
}
